# ══════════════════════════════════════════════════════════════
# .env  —  copy to config/.env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Date range (paper: Jan 2018 – Dec 2025) ───────────────
START_DATE=2018-01-01
END_DATE=2025-12-31

# ── Storage ───────────────────────────────────────────────
DATA_DIR=./data
LOG_DIR=./logs
DB_PATH=./data/run_log.db

# ── FRED  (free — https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key

# ── Reddit  (free — https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=crypto_research/1.0 by YourUsername

# ── Glassnode free tier  (https://studio.glassnode.com/settings/api)
GLASSNODE_API_KEY=your_glassnode_api_key

# ── Optional / paid ───────────────────────────────────────
COINGECKO_API_KEY=

# CoinMetrics (optional free key — get at https://coinmetrics.io/community/)
# The community API works without a key but adding one increases rate limits
COINMETRICS_API_KEY=
COINGLASS_API_KEY=
KAIKO_API_KEY=
WRDS_USERNAME=
WRDS_PASSWORD=

# ── Pushshift Reddit historical dumps (Gap 1 — social media NLP) ───────────
# Set this to the folder containing your downloaded .zst files from:
#   https://academictorrents.com/details/1614740ac8c94505e4ecb9d88be8bed7b6afddd4
# Only download: r_Bitcoin_submissions.zst, r_CryptoCurrency_submissions.zst,
#                r_ethereum_submissions.zst (and _comments variants)
# See collectors/pushshift_loader.py for full instructions.
PUSHSHIFT_DIR=~/pushshift_dumps

# NLP scorer for Pushshift: finbert (better, GPU recommended) or vader (fast, CPU)
PUSHSHIFT_SCORER=finbert
